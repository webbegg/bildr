{
  "name": "@bildr/codegen",
  "version": "0.1.0",
  "description": "The bildr model (.bildr/ files) and the generator that turns it into a clean-architecture Nuxt app. Pure TypeScript: no Vue, Nitro or fs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webbegg/bildr.git",
    "directory": "packages/codegen"
  },
  "type": "module",
  "exports": {
    "./model": "./src/model/index.ts",
    "./sync": "./src/sync/index.ts",
    "./starter": "./src/starter/index.ts",
    "./generate": "./src/generate/index.ts",
    "./design": "./src/design/index.ts",
    "./render": "./src/render/index.ts",
    "./edit": "./src/edit/index.ts",
    "./env": "./src/env/index.ts",
    "./migrate": "./src/migrate/index.ts",
    "./query": "./src/query/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./model": { "types": "./dist/model/index.d.ts", "default": "./dist/model/index.js" },
      "./sync": { "types": "./dist/sync/index.d.ts", "default": "./dist/sync/index.js" },
      "./starter": { "types": "./dist/starter/index.d.ts", "default": "./dist/starter/index.js" },
      "./generate": { "types": "./dist/generate/index.d.ts", "default": "./dist/generate/index.js" },
      "./design": { "types": "./dist/design/index.d.ts", "default": "./dist/design/index.js" },
      "./render": { "types": "./dist/render/index.d.ts", "default": "./dist/render/index.js" },
      "./edit": { "types": "./dist/edit/index.d.ts", "default": "./dist/edit/index.js" },
      "./env": { "types": "./dist/env/index.d.ts", "default": "./dist/env/index.js" },
      "./migrate": { "types": "./dist/migrate/index.d.ts", "default": "./dist/migrate/index.js" },
      "./query": { "types": "./dist/query/index.d.ts", "default": "./dist/query/index.js" }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
