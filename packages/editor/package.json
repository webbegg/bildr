{
  "name": "@bildr/editor",
  "version": "0.4.0",
  "description": "The bildr editor UI: a Vue + Nuxt UI single-page app that @bildr/nuxt serves at /__bildr during nuxt dev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webbegg/bildr.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --emptyOutDir",
    "prepack": "pnpm run build",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@bildr/codegen": "workspace:*",
    "@bildr/editor-core": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/ui": "^4.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
