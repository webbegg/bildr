{
  "name": "@bildr/nuxt",
  "version": "0.1.0",
  "description": "The bildr visual editor as a dev-only Nuxt module: `nuxt dev` serves it at /__bildr on starter-kit projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webbegg/bildr.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "exports": {
    ".": "./src/module.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/module.d.ts", "default": "./dist/module.js" }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bildr/codegen": "workspace:*",
    "@bildr/editor": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/kit": "^4.6.3",
    "@nuxt/schema": "^4.6.3",
    "h3": "^1.15.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
