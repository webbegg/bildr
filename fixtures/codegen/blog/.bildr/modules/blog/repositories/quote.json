{
  "$schema": "https://bildr.dev/schema/repository.v1.json",
  "id": "repo_quote",
  "entity": "ent_quote",
  "datasource": "ds_quotes",
  "operations": [
    "list"
  ],
  "rest": {
    "list": {
      "method": "GET",
      "path": "/quotes",
      "itemsPath": "quotes",
      "totalPath": "total"
    },
    "paging": {
      "style": "offset",
      "limitParam": "limit",
      "offsetParam": "skip"
    },
    "fieldMap": {
      "id": "id",
      "text": "quote",
      "author": "author"
    }
  },
  "expose": {
    "list": true
  }
}
