{
  "$schema": "https://bildr.dev/schema/component.v1.json",
  "id": "cmp_post_card",
  "name": "PostCard",
  "properties": [
    {
      "id": "prop_post",
      "name": "post",
      "kind": "entity",
      "entity": "ent_post",
      "pick": [
        "title",
        "slug",
        "body",
        "published"
      ],
      "required": true
    },
    {
      "id": "prop_cover",
      "name": "cover",
      "kind": "image",
      "default": ""
    },
    {
      "id": "prop_actions",
      "name": "actions",
      "kind": "slot",
      "nodeId": "n_actions"
    }
  ],
  "variants": [
    {
      "id": "var_compact",
      "name": "compact",
      "overrides": {
        "n_card": {
          "style": {
            "gap": "1",
            "p": "3"
          }
        },
        "n_excerpt": {
          "props": {
            "hidden": true
          }
        }
      }
    }
  ],
  "root": {
    "id": "n_card",
    "type": "Card",
    "style": {
      "gap": "2",
      "p": "5"
    },
    "children": [
      {
        "id": "n_cover",
        "type": "Image",
        "props": {
          "src": {
            "$bind": "cover"
          },
          "alt": {
            "$bind": "post.title"
          },
          "visible": {
            "$bind": "cover"
          }
        },
        "style": {
          "rounded": "md"
        }
      },
      {
        "id": "n_title_link",
        "type": "Link",
        "props": {
          "to": {
            "page": "pg_post_detail",
            "params": {
              "slug": {
                "$bind": "post.slug"
              }
            }
          }
        },
        "children": [
          {
            "id": "n_title",
            "type": "Heading",
            "props": {
              "level": 2,
              "text": {
                "$bind": "post.title"
              }
            },
            "style": {
              "text": "lg",
              "font": "semibold"
            }
          }
        ]
      },
      {
        "id": "n_excerpt",
        "type": "Text",
        "props": {
          "text": {
            "$bind": "post.body"
          }
        },
        "style": {
          "color": "muted"
        }
      },
      {
        "id": "n_draft",
        "type": "Text",
        "props": {
          "text": "Draft",
          "visible": {
            "not": {
              "$bind": "post.published"
            }
          }
        },
        "style": {
          "self": "start",
          "rounded": "sm",
          "bg": "elevated",
          "px": "2",
          "py": "0.5",
          "text": "xs"
        }
      },
      {
        "id": "n_actions",
        "type": "Row",
        "style": {
          "gap": "3",
          "items": "center"
        },
        "children": []
      }
    ]
  }
}
