{
  "$schema": "https://bildr.dev/schema/page.v1.json",
  "id": "pg_index",
  "name": "index",
  "path": "/",
  "layout": "lay_main",
  "layoutValues": {
    "prop_title": "Posts"
  },
  "seo": {
    "title": "Blog"
  },
  "uses": {
    "state": [
      {
        "as": "preferences",
        "state": "st_preferences"
      }
    ],
    "queries": [
      {
        "as": "featured",
        "query": "q_featured_posts",
        "args": {
          "limit": 6
        }
      },
      {
        "as": "all",
        "query": "q_all_posts"
      },
      {
        "as": "quotes",
        "query": "q_latest_quotes",
        "args": {
          "limit": 3
        }
      }
    ],
    "computed": [
      {
        "as": "posts",
        "if": {
          "$bind": "preferences.showDrafts"
        },
        "then": {
          "$bind": "all"
        },
        "else": {
          "$bind": "featured"
        }
      }
    ]
  },
  "root": {
    "id": "n_page",
    "type": "Page",
    "props": {
      "tag": "section"
    },
    "style": {
      "display": "flex",
      "direction": "col",
      "gap": "6"
    },
    "children": [
      {
        "id": "n_head",
        "type": "Row",
        "style": {
          "justify": "between",
          "items": "center"
        },
        "children": [
          {
            "id": "n_h1",
            "type": "Heading",
            "props": {
              "level": 1,
              "text": "Posts"
            },
            "style": {
              "text": "3xl",
              "font": "semibold"
            }
          },
          {
            "id": "n_toggle",
            "type": "Checkbox",
            "props": {
              "label": "Show drafts",
              "value": {
                "$bind": "preferences.showDrafts"
              }
            },
            "interactions": [
              {
                "on": "change",
                "do": [
                  {
                    "kind": "setState",
                    "state": "st_preferences",
                    "field": "showDrafts",
                    "value": {
                      "$event": "checked"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "n_list",
        "type": "List",
        "props": {
          "items": {
            "$bind": "posts"
          },
          "as": "post",
          "empty": "No posts yet.",
          "loading": "Loading…",
          "layout": "grid"
        },
        "style": {
          "display": "grid",
          "gap": "4",
          "sm:cols": "2"
        },
        "children": [
          {
            "id": "n_card",
            "type": "Instance",
            "props": {
              "component": "cmp_post_card",
              "values": {
                "prop_post": {
                  "$bind": "post"
                }
              }
            },
            "children": [
              {
                "id": "n_card_actions",
                "type": "SlotFill",
                "props": {
                  "slot": "prop_actions"
                },
                "children": [
                  {
                    "id": "n_read_more",
                    "type": "Link",
                    "props": {
                      "to": {
                        "page": "pg_post_detail",
                        "params": {
                          "slug": {
                            "$bind": "post.slug"
                          }
                        }
                      },
                      "text": "Read more",
                      "icon": "i-lucide-arrow-right"
                    },
                    "style": {
                      "text": "sm",
                      "color": "primary"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "n_quotes",
        "type": "List",
        "props": {
          "items": {
            "$bind": "quotes"
          },
          "as": "quote",
          "hideWhenEmpty": true,
          "tag": "aside"
        },
        "style": {
          "display": "flex",
          "direction": "col",
          "gap": "2",
          "borderT": "1",
          "borderColor": "default",
          "pt": "6"
        },
        "children": [
          {
            "id": "n_quote",
            "type": "Text",
            "props": {
              "text": {
                "$template": "“{quote.text}” — {quote.author}"
              }
            },
            "style": {
              "text": "sm"
            }
          }
        ]
      },
      {
        "id": "n_about",
        "type": "Grid",
        "style": {
          "gap": "6",
          "items": "center",
          "cols": "1",
          "md:cols": "3"
        },
        "children": [
          {
            "id": "n_about_image",
            "type": "Image",
            "props": {
              "src": "/uploads/notebook.svg",
              "alt": "An open notebook"
            },
            "style": {
              "rounded": "lg"
            }
          },
          {
            "id": "n_about_text",
            "type": "Column",
            "style": {
              "gap": "2",
              "md:colSpan": "2"
            },
            "children": [
              {
                "id": "n_about_title",
                "type": "Heading",
                "props": {
                  "level": 2,
                  "text": "About this blog"
                },
                "style": {
                  "text": "xl",
                  "font": "semibold"
                }
              },
              {
                "id": "n_about_body",
                "type": "Text",
                "props": {
                  "text": "Notes on building apps from a model.\nNew posts most weeks."
                },
                "style": {
                  "color": "muted"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
