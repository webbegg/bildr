{
  "$schema": "https://bildr.dev/schema/page.v1.json",
  "id": "pg_new_post",
  "name": "posts-new",
  "path": "/posts/new",
  "layout": "lay_main",
  "seo": {
    "title": "New post"
  },
  "uses": {
    "actions": [
      {
        "as": "createPost",
        "action": "act_create_post"
      }
    ]
  },
  "root": {
    "id": "n_page",
    "type": "Page",
    "children": [
      {
        "id": "n_form",
        "type": "Form",
        "props": {
          "action": "act_create_post",
          "fields": [
            "fld_title",
            "fld_slug",
            "fld_body",
            "fld_published"
          ]
        },
        "style": {
          "display": "flex",
          "direction": "col",
          "gap": "4",
          "maxW": "xl"
        },
        "interactions": [
          {
            "on": "submit",
            "do": [
              {
                "kind": "runAction",
                "action": "act_create_post",
                "args": {
                  "$form": true
                }
              },
              {
                "kind": "navigate",
                "to": {
                  "page": "pg_post_detail",
                  "params": {
                    "slug": {
                      "$form": "slug"
                    }
                  }
                },
                "when": "success"
              }
            ]
          }
        ],
        "children": [
          {
            "id": "n_h1",
            "type": "Heading",
            "props": {
              "level": 1,
              "text": "New post"
            },
            "style": {
              "text": "3xl",
              "font": "semibold"
            }
          },
          {
            "id": "n_title",
            "type": "Input",
            "props": {
              "field": "fld_title",
              "label": "Title"
            }
          },
          {
            "id": "n_slug",
            "type": "Input",
            "props": {
              "field": "fld_slug",
              "label": "Slug"
            }
          },
          {
            "id": "n_body",
            "type": "Input",
            "props": {
              "field": "fld_body",
              "label": "Body",
              "multiline": true,
              "rows": 6
            }
          },
          {
            "id": "n_published",
            "type": "Checkbox",
            "props": {
              "field": "fld_published",
              "label": "Publish now"
            }
          },
          {
            "id": "n_error",
            "type": "Text",
            "props": {
              "text": {
                "$bind": "createPost.error"
              },
              "visible": {
                "$bind": "createPost.error"
              }
            },
            "style": {
              "text": "sm",
              "color": "error"
            }
          },
          {
            "id": "n_submit",
            "type": "Button",
            "props": {
              "text": "Create",
              "type": "submit",
              "disabled": {
                "$bind": "createPost.pending"
              }
            }
          }
        ]
      }
    ]
  }
}
