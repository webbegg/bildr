{
  "$schema": "https://bildr.dev/schema/query.v1.json",
  "id": "q_post_by_slug",
  "name": "postBySlug",
  "label": "Post by slug",
  "from": "ent_post",
  "params": [{ "name": "slug", "type": "text", "reactive": true }],
  "where": { "op": "eq", "field": "slug", "value": { "$param": "slug" } },
  "result": "one"
}
