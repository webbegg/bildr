{
  "$schema": "https://bildr.dev/schema/datasource.v1.json",
  "id": "ds_catalog",
  "name": "catalog",
  "kind": "api",
  "env": {
    "baseUrl": "NUXT_APIS_CATALOG_BASE_URL",
    "apiKey": "NUXT_APIS_CATALOG_API_KEY"
  },
  "auth": {
    "type": "bearer",
    "secret": "apiKey"
  },
  "baseUrl": "https://catalog.example.com/v1",
  "runtime": "server",
  "models": [
    {
      "name": "Category",
      "fields": [
        {
          "name": "id",
          "type": "integer"
        },
        {
          "name": "name",
          "type": "text"
        }
      ]
    },
    {
      "name": "Product",
      "fields": [
        {
          "name": "id",
          "type": "integer"
        },
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "price",
          "type": "number"
        },
        {
          "name": "inStock",
          "type": "boolean",
          "optional": true,
          "key": "in_stock"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "key": "created_at"
        },
        {
          "name": "note",
          "type": "text",
          "nullable": true
        },
        {
          "name": "categories",
          "type": "model",
          "model": "Category",
          "list": true
        }
      ]
    }
  ],
  "queries": [
    {
      "name": "products",
      "description": "The products, newest first, optionally of one category.",
      "path": "/products",
      "params": [
        {
          "name": "category",
          "in": "query",
          "type": "text",
          "key": "cat"
        },
        {
          "name": "locale",
          "in": "header",
          "type": "text",
          "key": "Accept-Language"
        }
      ],
      "headers": [
        {
          "name": "X-Api-Version",
          "value": "2"
        }
      ],
      "result": {
        "model": "Product",
        "many": true,
        "itemsPath": "data.items"
      }
    },
    {
      "name": "product",
      "path": "/products/:id",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer"
        }
      ],
      "result": {
        "model": "Product",
        "many": false
      }
    }
  ],
  "actions": [
    {
      "name": "createProduct",
      "method": "POST",
      "path": "/products",
      "params": [],
      "body": {
        "model": "Product"
      },
      "result": {
        "model": "Product",
        "many": false
      }
    },
    {
      "name": "deleteProduct",
      "method": "DELETE",
      "path": "/products/:id",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer"
        }
      ]
    }
  ]
}
