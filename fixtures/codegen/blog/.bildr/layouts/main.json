{
  "$schema": "https://bildr.dev/schema/layout.v1.json",
  "id": "lay_main",
  "name": "main",
  "slots": [
    {
      "id": "children",
      "name": "children",
      "nodeId": "n_main"
    },
    {
      "id": "footer",
      "name": "footer",
      "nodeId": "n_footer"
    }
  ],
  "root": {
    "id": "n_root",
    "type": "Container",
    "style": {
      "display": "flex",
      "direction": "col",
      "minH": "screen"
    },
    "children": [
      {
        "id": "n_header",
        "type": "Container",
        "props": {
          "tag": "header"
        },
        "style": {
          "borderB": "1",
          "borderColor": "default"
        },
        "children": [
          {
            "id": "n_nav",
            "type": "Row",
            "props": {
              "tag": "nav"
            },
            "style": {
              "maxW": "4xl",
              "mx": "auto",
              "justify": "between",
              "items": "center",
              "p": "4"
            },
            "children": [
              {
                "id": "n_brand",
                "type": "Link",
                "props": {
                  "to": {
                    "page": "pg_index"
                  },
                  "text": {
                    "$bind": "site.name"
                  }
                },
                "style": {
                  "text": "lg",
                  "font": "semibold"
                }
              },
              {
                "id": "n_new",
                "type": "Link",
                "props": {
                  "to": {
                    "page": "pg_new_post"
                  },
                  "text": "New post"
                },
                "style": {
                  "bg": "primary",
                  "color": "inverted",
                  "px": "3",
                  "py": "1.5",
                  "rounded": "md",
                  "text": "sm"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "n_main",
        "type": "Container",
        "props": {
          "tag": "main"
        },
        "style": {
          "maxW": "4xl",
          "mx": "auto",
          "w": "full",
          "p": "4"
        },
        "children": []
      },
      {
        "id": "n_footer",
        "type": "Container",
        "props": {
          "tag": "footer"
        },
        "style": {
          "borderT": "1",
          "borderColor": "default",
          "mt": "auto",
          "p": "4",
          "align": "center",
          "text": "sm",
          "color": "muted"
        },
        "children": [
          {
            "id": "n_footer_text",
            "type": "Text",
            "props": {
              "text": {
                "$bind": "site.description"
              }
            }
          }
        ]
      }
    ]
  }
}
