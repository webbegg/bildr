# Database (libSQL: a local file by default, or a remote libsql:// URL)
NUXT_DB_URL=file:.data/app.db

# Data source "quotes" (REST)
NUXT_DATASOURCES_QUOTES_BASE_URL=https://dummyjson.com
NUXT_DATASOURCES_QUOTES_API_KEY=

# Data source "catalog" (API, runs on the server)
NUXT_APIS_CATALOG_BASE_URL=https://catalog.example.com/v1
NUXT_APIS_CATALOG_API_KEY=
