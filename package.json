{
  "name": "bildr-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build:editor": "pnpm --filter @bildr/editor build",
    "build:packages": "pnpm --filter './packages/**' build",
    "e2e:generated": "node e2e/generated.mjs",
    "e2e:module": "node e2e/module/all.mjs",
    "palettes": "node --experimental-strip-types scripts/generate-palettes.ts",
    "lint": "eslint .",
    "release": "node scripts/release.ts",
    "test": "vitest run --maxWorkers=50%",
    "typecheck": "pnpm --filter './packages/**' typecheck"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.15.0"
}
